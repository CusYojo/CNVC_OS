NODE_ENV=development
API_PORT=4100
#@Abigtiger1234
# MySQL 8.x。DB_FREFIX 是现有部署契约中的历史拼写，代码按该名称读取。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cybernaut_mvp
DB_USERNAME=cybernaut
DB_PASSWORD=change-me
DB_FREFIX=sbl_
# 一次性账号分离工具输入；preview 不需要，apply 时通过受控临时环境注入。
# 配置完成后把 Runtime 凭据写入上方 DB_USERNAME/DB_PASSWORD；Migration 凭据只放入 root-owned DB_MIGRATION_ENV_FILE。
# DB_RUNTIME_USERNAME=cybernaut_runtime
# DB_RUNTIME_HOST=127.0.0.1
# DB_RUNTIME_PASSWORD=replace-with-strong-secret
# DB_MIGRATION_USERNAME=cybernaut_migration
# DB_MIGRATION_HOST=127.0.0.1
# DB_MIGRATION_PASSWORD=replace-with-strong-secret
# 备份使用 Runtime 账号只读；恢复演练在同一数据库的随机隔离前缀执行，DDL 只使用
# root-owned 迁移凭据文件中的 DB_MIGRATION_USERNAME/DB_MIGRATION_PASSWORD。
# MYSQL_BACKUP_MAX_SECONDS=300
# MYSQL_RESTORE_MAX_SECONDS=300
# MYSQL_BACKUP_ROOT=/var/lib/cybernaut/mysql-backups
# MYSQL_RESTORE_EVIDENCE_ROOT=/var/lib/cybernaut/migration-evidence/mysql-restore
# MYSQL_BACKUP_INVENTORY_EVIDENCE_ROOT=/var/lib/cybernaut/migration-evidence/mysql-backup-inventory
# MYSQL_BACKUP_RETENTION_DAYS=35
# MYSQL_BACKUP_MAX_AGE_HOURS=26
# MYSQL_RESTORE_DRILL_MAX_AGE_DAYS=30
# MYSQL_BACKUP_OWNER_ROLE=database-operations-on-call
# MYSQL_RESTORE_OWNER_ROLE=migration-release-commander
# MYSQL_BACKUP_APPROVER_ROLE=data-owner
# 生产必须同时配置不含密钥的异地位置标识，并确认介质静态加密。
# MYSQL_BACKUP_OFFSITE_LOCATION_ID=approved-offsite-vault
# MYSQL_BACKUP_ENCRYPTION_AT_REST_CONFIRMED=true
DB_POOL_SIZE=10
DB_POOL_QUEUE_LIMIT=40
DB_CONNECT_TIMEOUT_MS=10000
PROJECT_FILE_TEMP_MAX_AGE_MS=86400000

# 仅用于切换后的回滚观察窗。两项必须成对启用；启用后统一服务只允许
# GET/HEAD/OPTIONS，MySQL 连接默认只读，并停用所有恢复、回填、Worker 与调度写入。
# 结束观察窗前必须按切换手册完成 PONR 审批；不可用此开关伪装长期运行模式。
MIGRATION_WRITE_FREEZE=false
MIGRATION_WRITE_FREEZE_MODE=

# 单服务运维快照阈值；指标由 /api/operations/metrics 提供且仅系统管理员可访问。
OPS_HTTP_MIN_REQUESTS=20
OPS_HTTP_SERVER_ERROR_RATE_WARN=0.05
OPS_HTTP_P95_MS_WARN=2000
OPS_MYSQL_WAITING_REQUESTS_WARN=1
OPS_MYSQL_ROW_LOCK_CURRENT_WAITS_WARN=1
OPS_MYSQL_REPLICATION_LAG_SECONDS_WARN=300
OPS_QUEUE_DEAD_LETTERS_WARN=1
OPS_FILE_PARSE_FAILURES_WARN=1
OPS_AUTH_DENIED_15M_WARN=5
OPS_AUTH_PREVIOUS_KEY_MATCHES_24H_WARN=1
OPS_CREDENTIAL_CHANGES_15M_WARN=1
OPS_HIGH_RISK_TOOL_DENIED_15M_WARN=1
OPS_CDC_LAG_MS_WARN=300000
OPS_LEAD_SOURCE_MISSING_WARN=1
OPS_LEAD_REVIEW_PENDING_WARN=20
OPS_LEAD_REVIEW_OLDEST_AGE_MS_WARN=86400000
OPS_LEAD_ENTITY_DUPLICATE_GROUPS_WARN=1
OPS_FILE_DISK_FREE_BYTES_WARN=5368709120
OPS_FILE_DISK_USED_RATIO_WARN=0.9
OPS_FILE_DISK_USED_RATIO_GROWTH_24H_WARN=0.05
OPS_AI_FIRST_TOKEN_MIN_REQUESTS=5
OPS_AI_FIRST_TOKEN_P95_MS_WARN=5000
OPS_AI_FIRST_TOKEN_OBSERVATION_COVERAGE_WARN=0.8
OPS_FILE_CAPACITY_SNAPSHOT_INTERVAL_SECONDS=3600
OPS_DOCUMENT_RENDER_FAILURES_WARN=1
OPS_DOCUMENT_QUALITY_FAILURES_WARN=1
OPS_DOCUMENT_FONT_FAILURES_WARN=1
OPS_JOB_FAILURES_24H_WARN=1
OPS_JOB_DEAD_LETTERS_24H_WARN=1
OPS_JOB_RETRIED_RECORDS_24H_WARN=5
OPS_JOB_TIMEOUT_FAILURES_24H_WARN=1
OPS_JOB_LEASE_RECOVERIES_24H_WARN=1
OPS_JOB_EXPIRED_LEASES_WARN=1
OPS_JOB_LEASE_CONTENTIONS_24H_WARN=10
OPS_JOB_DUPLICATE_SUPPRESSED_24H_WARN=20
OPS_JOB_STALE_COMPLETIONS_24H_WARN=1
OPS_SUPERVISED_PROCESS_FAILURES_24H_WARN=1
OPS_SUPERVISED_PROCESS_TIMEOUTS_24H_WARN=1
OPS_SUPERVISED_PROCESS_FORCE_KILLS_24H_WARN=1
OPS_ALERT_OWNER_ROLE=operations-on-call
# 必须填写已启用的 im_bot_bindings.id UUID；凭据仍只保存在加密的 IM Bot 配置中。
OPS_ALERT_NOTIFICATION_CHANNEL_ID=
# 同一告警状态的重复提醒间隔，范围 5～10080 分钟。
OPS_ALERT_REMINDER_MINUTES=60
# 只填不含密钥的外部升级策略标识；API 仅暴露是否配置，不返回值。
OPS_ALERT_ESCALATION_POLICY_ID=

# 迁移工具专用：只在盘点/迁移窗口指向经批准的源端，平时不参与应用运行。
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/cybernaut_mvp
# PG_DUMP_PATH=cybernaut_mvp_dump.sql
# JW_MIGRATION_BACKUP_ROOT=/absolute/path/to/jw-backup
# MIGRATION_SOURCE_SCAN_MAX_FILES=200000

# 历史演示账号生成器已永久退役；保留该键仅兼容旧部署，始终保持 0。
SEED_DEMO_USERS=0

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
AUTH_SESSION_SECRET=change-me-too
# 轮换时先把旧密钥放入逗号分隔列表；所有活跃会话续期到新密钥后再移除。
AUTH_SESSION_PREVIOUS_SECRETS=
AUTH_SESSION_KEY_ROTATION_STARTED_AT=
AUTH_SESSION_MAX_ACTIVE=5
AUTH_SESSION_TTL_MINUTES=1440
AUTH_SESSION_REMEMBER_TTL_DAYS=30
AUTH_SESSION_RENEW_WINDOW_PERCENT=25
AUTH_PASSWORD_BCRYPT_ROUNDS=12

# 项目资料上传：原始文件、OOXML 条目数和解压后容量上限。
PROJECT_FILE_MAX_BYTES=104857600
PROJECT_FILE_ARCHIVE_MAX_ENTRIES=5000
PROJECT_FILE_ARCHIVE_MAX_UNCOMPRESSED_BYTES=262144000
PROJECT_FILE_MAX_COUNT_PER_PROJECT=500
PROJECT_FILE_MAX_BYTES_PER_PROJECT=5368709120
PROJECT_FILE_MAX_BYTES_PER_USER=21474836480

# Web 默认仅接受 MySQL 服务端会话；旧 Bearer JWT 只允许在有审批的迁移验收窗口显式开启。
AUTH_ALLOW_LEGACY_BEARER=false
AUTH_LEGACY_BEARER_CUTOFF=
AUTH_LEGACY_BEARER_ALLOWED_USER_IDS=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173

# 生产必须使用至少 32 字符的非示例 JWT/会话密钥、HTTPS Origin 和 Secure Cookie；
# 否则统一服务会拒绝启动。开发环境可保留上述本机 HTTP 配置。

LLM_BASE_URL=
LLM_MODEL=
LEAD_ENRICHMENT_MODEL=
# `codex-cli` 使用本机 `codex --search exec`；留空时沿用已配置的HTTP模型网关。
LEAD_ENRICHMENT_RESEARCH_BACKEND=
LLM_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
# 供受监督 Python 图片/PDF 子进程验证 HTTPS；留空时使用受支持平台的系统 CA 文件。
AI_PYTHON_CA_FILE=
# 正式 Q&A DOCX 的逐页渲染工具；部署脚本会写入绝对路径，本机开发可留空自动发现。
AI_QA_SOFFICE_BINARY=
AI_QA_PDFTOPPM_BINARY=
AI_QA_PDFFONTS_BINARY=

# MySQL 中模型/IM 等可替换凭据使用 AES-256-GCM 加密；填 32 字节 Base64 或 64 位 Hex。
# 此密钥只能由部署环境注入，不得写入数据库；轮换前必须先执行凭据重加密流程。
MODEL_CREDENTIAL_ENCRYPTION_KEY=
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=
# 可选逗号分隔主机白名单，例如 skill.zeelin.cn。生产默认禁止 HTTP Provider。
MODEL_PROVIDER_ALLOWED_HOSTS=
MODEL_PROVIDER_ALLOW_HTTP=false

# IM 机器人在同一业务进程内由 MySQL Outbox 调度。可选扩展 Webhook 主机白名单。
IM_WEBHOOK_ALLOWED_HOSTS=
AI_CAPABILITIES_ENABLED=true
IM_INTEGRATIONS_ENABLED=true
IM_OUTBOX_ENABLED=true
IM_OUTBOX_INTERVAL_SECONDS=15
IM_OUTBOX_BATCH_SIZE=10
# 微信扫码机器人单个出站产物的内存读取/上传上限；最大允许 83886080（80 MiB）。
WEIXIN_MAX_FILE_BYTES=83886080
# 微信入站图片解密后大小上限；最大允许 26214400（25 MiB）。
WEIXIN_INBOUND_IMAGE_MAX_BYTES=15728640
WEIXIN_INBOUND_FILE_MAX_BYTES=12582912
WEIXIN_INBOUND_TEXT_MAX_CHARS=120000

JW_AGENT_MODEL=
# 仅控制新建会话；关闭后已有 MySQL 会话仍可读取和续聊，且绝不回退到 Flue。
JW_GLOBAL_NEW_CONVERSATIONS_ENABLED=true
JW_PROJECT_NEW_CONVERSATIONS_ENABLED=true
# 生产 Runtime 强制使用 dontAsk + 固定 MCP 工具白名单；此值仅保留兼容可见性。
JW_AGENT_PERMISSION_MODE=dontAsk
JW_AGENT_MAX_TURNS=12
JW_AGENT_MAX_BUDGET_USD=5
JW_AGENT_INTERACTION_TIMEOUT_MS=900000
SOCKET_AUTH_REVALIDATE_MS=60000
SOCKET_RECONNECT_WINDOW_MS=300000
# Socket 握手、订阅、广播和重认证共享的 MySQL 并发上限；应小于 DB_CONNECTION_LIMIT。
SOCKET_DB_CONCURRENCY=8

# 线索主体识别/评分 Agent 均使用 Claude Agent SDK，禁止工具、Skill、MCP 和 DB_* 环境变量。
LEAD_SUBJECT_AGENT_MAX_TURNS=2
LEAD_SUBJECT_AGENT_MAX_BUDGET_USD=0.25
LEAD_SCORING_AGENT_MAX_TURNS=2
LEAD_SCORING_AGENT_MAX_BUDGET_USD=0.75
LEAD_WORKFLOW_AGENT_MAX_TURNS=2
LEAD_WORKFLOW_AGENT_MAX_BUDGET_USD=0.50
LEAD_WORKFLOW_AGENT_TIMEOUT_MS=180000
# 五类线索 Agent 共享的 MySQL 持久化并发、速率、日预算和连续失败熔断。
LEAD_AGENT_GLOBAL_MAX_CONCURRENCY=12
LEAD_AGENT_GLOBAL_MAX_REQUESTS_PER_MINUTE=60
LEAD_AGENT_GLOBAL_DAILY_BUDGET_USD=100
LEAD_AGENT_GLOBAL_RESERVATION_USD=0.75
LEAD_AGENT_CIRCUIT_FAILURE_THRESHOLD=5
LEAD_AGENT_CIRCUIT_OPEN_MS=300000
LEAD_AGENT_PERMIT_TTL_MS=600000
LEAD_AGENT_PERMIT_RETENTION_DAYS=30
SCORE_MODEL=
SCORE_FALLBACK_MODEL=
SCORE_REQUEST_TIMEOUT_MS=360000

# MySQL 持久化任务调度。单实例和多实例都必须使用同一 MySQL。
RUNTIME_JOB_POLL_MS=5000
RUNTIME_JOB_LEASE_SECONDS=900
RUNTIME_JOB_MAX_RETRIES=3
RUNTIME_JOB_CONCURRENCY=1

# 项目评分和长 AI 文档任务的 MySQL 租约。
PROJECT_SCORE_QUEUE_CONCURRENCY=1
PROJECT_SCORE_JOB_POLL_MS=1000
PROJECT_SCORE_JOB_LEASE_SECONDS=900
PROJECT_SCORE_MAX_ATTEMPTS=3
PROJECT_SCORE_RETRY_BASE_MS=60000
AI_TASK_LEASE_SECONDS=900

# 共享线索详情字段联网补全（V8 web-hit）：仅运行当前详情页消费的专题。
# 两个开关相互独立：停止新任务入队、暂停 Worker。
# 回滚时可先关闭 ACCEPT_NEW_JOBS，再等待运行中任务完成后关闭 ENABLED；
# 共享线索评分链路已退役，V8 快照只刷新补全与投资画像投影。
LEAD_ENRICHMENT_ACCEPT_NEW_JOBS=true
LEAD_ENRICHMENT_ENABLED=true
LEAD_ENRICHMENT_CONCURRENCY=10
# 临时专用 Worker 可精确限定一个持久化 trigger_type；统一主服务保持为空。
LEAD_ENRICHMENT_TRIGGER_TYPE_FILTER=
LEAD_ENRICHMENT_RESERVATION_USD=0.25
# 正式画像缺失时是否返回已有入池资料；开启后页面必须标记“已有资料 · 待核验”。
LEAD_POOL_SHOW_CANDIDATE_DATA=false
LEAD_ENRICHMENT_POLL_MS=2000
LEAD_ENRICHMENT_LEASE_SECONDS=600
LEAD_ENRICHMENT_MAX_ATTEMPTS=3
# 所有主机、Worker和线索Agent共用上方的 MySQL 许可池；其并发上限应高于
# LEAD_ENRICHMENT_CONCURRENCY，预留任务收口和其他线索 Agent 的调度余量。
# 上游账号额度不足属于全局计费故障：当前专题直接进入死信，Worker暂停领取新专题，等待充值或人工恢复。
LEAD_ENRICHMENT_BILLING_COOLDOWN_MS=900000
LEAD_TOPIC_SEARCH_CACHE_HOURS=24
# One-shot paid Codex/web prefetch remains disabled unless explicitly enabled
# for a bounded list of 1-10 confirmed lead subjects.
ALLOW_REAL_WEB_ACCEPTANCE=0
ALLOW_LEAD_RESEARCH_PREFETCH=0
LEAD_SOURCE_CACHE_HOURS=24
LEAD_SOURCE_MAX_BYTES=5000000
# 单专题硬预算；预算超限为不可重试终态，防止确定性超限反复消耗。
LEAD_ENRICHMENT_MAX_INPUT_TOKENS_PER_TOPIC=120000
LEAD_ENRICHMENT_MAX_OUTPUT_TOKENS_PER_TOPIC=6000
# 仅在配置模型单价时启用美元上限；0表示不按金额拦截，Token上限仍生效。
LEAD_ENRICHMENT_MAX_ESTIMATED_COST_USD_PER_TOPIC=0
# 按实际模型价格填写；为空或0时成本显示为“未配置”，不会伪造金额。
LEAD_ENRICHMENT_INPUT_USD_PER_MILLION=0
LEAD_ENRICHMENT_OUTPUT_USD_PER_MILLION=0

# 旧36氪储备池已被实时项目源替代，仅在明确回滚时临时开启。
# DAILY_INTAKE_ENABLED 为历史配置，不再控制运行任务。
DAILY_INTAKE_ENABLED=false
LEGACY_LEAD_RESERVE_INTAKE_ENABLED=false
DAILY_INTAKE=50
DAILY_INTAKE_HOUR=9
DAILY_INTAKE_MINUTE=0

# 36氪全行业项目（成立时间不早于2025年）：采集和每日准入是两个独立开关。首次迁移、预览和灰度验收
# 完成前保持 false；旧 DAILY_INTAKE 仅在新链路通过切换验收后再由运维关闭。
KR36_PROJECT_SYNC_ENABLED=false
KR36_PROJECT_SYNC_MODE=incremental
KR36_PROJECT_SYNC_INTERVAL_SECONDS=21600
KR36_PROJECT_SYNC_START_DELAY_MS=300000
KR36_PROJECT_MIN_FOUNDED_YEAR=2025
KR36_PROJECT_INCREMENTAL_PAGES=4
KR36_PROJECT_MAX_BACKFILL_PAGES=500
KR36_PROJECT_DETAIL_CONCURRENCY=3
KR36_PROJECT_REQUEST_MIN_DELAY_MS=350
KR36_PROJECT_MAX_RETRIES=3
KR36_PROJECT_RECHECK_RECENT_DAYS=90
KR36_PROJECT_RECHECK_LIMIT=200
KR36_PROJECT_SAFETY_STOCK_DAYS=45
KR36_PROJECT_ADMISSION_ENABLED=false
KR36_PROJECT_DAILY_QUOTA=10
KR36_PROJECT_ADMISSION_HOUR=9
KR36_PROJECT_ADMISSION_MINUTE=10

# Radar 不再监听 8121，也不启动 Python；采集器在 Node API 进程内运行。
RADAR_SYNC_ENABLED=true
RADAR_SYNC_INTERVAL_MS=1800000
RADAR_SYNC_START_DELAY_MS=120000
RADAR_SYNC_PAGE_SIZE=50
RADAR_SYNC_INCREMENTAL_PAGES=4
RADAR_SYNC_BACKFILL_PAGES=1
RADAR_PAPER_CRAWL_ENABLED=true
RADAR_PAPER_DAILY_HOUR=7
RADAR_PAPER_DAILY_MINUTE=30
RADAR_WORKFLOW_CONCURRENCY=2
RADAR_WECHAT_DAILY_ENABLED=true
RADAR_WECHAT_RETRY_INTERVAL_SECONDS=1800
RADAR_WECHAT_INSTITUTION_INTERVAL_SECONDS=7200
RADAR_DATA_DIR=
RADAR_WECHAT_ACCOUNTS_XLSX=
OPENALEX_API_KEY=
RADAR_PRODUCTION_ASSET_MANIFEST=
GSDATA_APP_KEY=
GSDATA_APP_SECRET=
LEAD_RESEARCH_PROFILE_ENABLED=false
LEAD_RESEARCH_WEB_ENRICHMENT_ENABLED=false
LEAD_RESEARCH_WEB_ENRICHMENT_AFTER=
LEAD_POOL_RESEARCH_ADAPTIVE_COLUMNS=false
