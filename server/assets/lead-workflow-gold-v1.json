{
  "version": "lead-workflow-gold-v1",
  "description": "研究、初筛和增量补全三个 Profile 的技术金标；验证事实/冲突、准入决策、白名单补丁、来源绑定和运行边界。",
  "thresholds": {
    "minContractAccuracy": 1,
    "minEvidenceBindingAccuracy": 1,
    "maxAverageCostUsd": 0.1,
    "maxAverageDurationMs": 60000,
    "maxTurns": 2,
    "maxToolCalls": 0,
    "maxAttemptsPerCase": 2,
    "maxRetryRate": 0.15
  },
  "cases": [
    {
      "id": "research-verified-fact-001",
      "profile": "lead-research-agent",
      "category": "verified-fact",
      "input": {
        "contractVersion": "lead-research-host-tools-v1",
        "immutableEvent": {
          "id": "event-research-verified-001",
          "sourceType": "public-intel",
          "sourceId": "official-disclosure-001"
        },
        "existingLead": null,
        "sources": [
          {
            "sourceId": "official-001",
            "sourceType": "company-official",
            "title": "澄明机器人官方融资公告",
            "quote": "澄明机器人有限公司于2025年3月完成5000万元A轮融资，资金将用于工业巡检机器人量产。",
            "sourceUrl": "https://example.com/chengming/official-a",
            "reliability": "high"
          }
        ]
      },
      "expected": {
        "minFacts": 1,
        "maxConflicts": 0,
        "minGaps": 1,
        "requiredEvidenceSourceIds": ["official-001"]
      }
    },
    {
      "id": "research-conflict-preserved-001",
      "profile": "lead-research-agent",
      "category": "conflict",
      "input": {
        "contractVersion": "lead-research-host-tools-v1",
        "immutableEvent": {
          "id": "event-research-conflict-001",
