          "sourceId": "valuation-conflict-001"
        },
        "sources": [
          {
            "sourceId": "financing-news-001",
            "sourceType": "media",
            "title": "融资报道",
            "quote": "本轮融资后公司估值为4亿元。",
            "sourceUrl": "https://example.com/news/valuation",
            "reliability": "medium"
          },
          {
            "sourceId": "company-statement-001",
            "sourceType": "company-official",
            "title": "公司声明",
            "quote": "公司声明本轮投后估值为8亿元。",
            "sourceUrl": "https://example.com/company/valuation",
            "reliability": "medium"
          }
        ],
        "researchFacts": {
          "summary": "投后估值存在重大冲突。",
          "facts": [],
          "conflicts": [
            {
              "field": "valuation",
              "values": ["4亿元", "8亿元"],
              "reason": "媒体报道与公司声明不一致",
              "sourceIds": ["financing-news-001", "company-statement-001"]
            }
          ],
          "gaps": ["缺少交易文件"]
        }
      },
      "expected": {
        "decision": "review"
      }
    },
