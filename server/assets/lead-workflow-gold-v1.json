            "sourceUrl": "https://example.com/lingbo/about",
            "reliability": "medium"
          },
          {
            "sourceId": "registry-location-001",
            "sourceType": "registry",
            "title": "企业登记信息",
            "quote": "凌波传感技术有限公司登记住所为上海市浦东新区。",
            "sourceUrl": "https://example.com/lingbo/registry",
            "reliability": "high"
          }
        ]
      },
      "expected": {
        "minConflicts": 1,
        "requiredConflictSourceIds": ["official-location-001", "registry-location-001"]
      }
    },
    {
      "id": "screening-evidenced-accept-001",
      "profile": "lead-screening-agent",
      "category": "accept",
      "input": {
        "contractVersion": "lead-research-host-tools-v1",
        "immutableEvent": {
          "id": "event-screening-accept-001",
          "sourceType": "radar",
          "sourceId": "customer-validation-001"
        },
        "sources": [
          {
            "sourceId": "customer-001",
            "sourceType": "customer-announcement",
            "title": "客户采购公告",
            "quote": "远航汽车已采购澄明机器人20套工业巡检设备，并完成首批验收。",
            "sourceUrl": "https://example.com/customer/procurement",
            "reliability": "high"
          }
        ],
        "researchFacts": {
          "summary": "存在可核验客户采购与验收。",
          "facts": [
            {
              "claim": "远航汽车完成设备采购与首批验收",
              "quote": "远航汽车已采购澄明机器人20套工业巡检设备，并完成首批验收。",
              "sourceId": "customer-001",
              "sourceUrl": "https://example.com/customer/procurement",
              "reliability": "high",
              "verificationStatus": "verified"
            }
          ],
          "conflicts": [],
          "gaps": ["合同金额未披露"]
        }
      },
      "expected": {
        "decision": "accept",
        "minEvidence": 1,
        "requiredEvidenceSourceIds": ["customer-001"]
      }
    },
    {
      "id": "screening-conflict-review-001",
      "profile": "lead-screening-agent",
      "category": "review",
      "input": {
        "contractVersion": "lead-research-host-tools-v1",
        "immutableEvent": {
          "id": "event-screening-review-001",
