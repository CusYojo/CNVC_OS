  "execution_overrides": {
    "composition_rules": {
      "max_primary_blocks": 2,
      "max_equal_cards": 2,
      "require_explicit_primary_reading_path": true,
      "prefer_process_over_field_table": true,
      "use_full_width_evidence_band_when_it_reduces_fragmentation": true
