    "require_full_deck_contact_sheet": true
  },
  "negative_constraints_additions": [
    "Do not turn evidence density into many equal cards.",
    "Do not let a page contain more than two major information islands.",
    "Do not use a field table when a process, flow, migration, waterfall, funnel or roadmap explains the relationship.",
