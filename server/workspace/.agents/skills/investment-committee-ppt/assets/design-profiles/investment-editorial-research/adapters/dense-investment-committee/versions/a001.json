    "evidence_rules": {
      "grade_a_b_c": true,
      "actual_forecast_management_target_separated": true,
      "intent_order_contract_revenue_collection_separated": true,
      "numeric_definition_unit_period_and_source_required": true,
      "baseline_metric_destination_required": true
    },
    "layout_rules": {
      "preferred_archetype_rotation": [
        "annotated_scene",
        "industry_change_path",
        "bottleneck_comparison",
        "capability_stack",
        "feedback_loop",
        "customer_case_journey",
        "commercial_relay",
        "financial_migration",
        "operating_waterfall",
        "order_funnel",
        "transaction_flow",
        "milestone_roadmap"
      ],
      "table_share_target_max": 0.25,
      "avoid_same_archetype_on_adjacent_slides": true,
      "avoid_more_than_two_information_islands": true
    }
  },
  "token_overrides": {
    "spacing": {
      "content_area_fill_target": "78_to_90_percent",
      "paragraph_to_paragraph_ratio": "1:1.5",
      "group_gap_px": [
