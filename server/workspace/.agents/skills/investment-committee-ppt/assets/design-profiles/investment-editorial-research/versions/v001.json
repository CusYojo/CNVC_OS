  "negative_constraints": [
    "Do not use dark navy as the default full-slide background.",
    "Do not create three or four equal rounded cards as the default composition.",
    "Do not repeat one two-column skeleton across the deck.",
    "Do not use giant isolated numbers without unit, period, driver and context.",
    "Do not use tables for processes, causal chains, stage migration or transaction flow.",
    "Do not shrink 11.x pt body text to fit; rewrite or recompose.",
    "Do not place lines, arrows or separators within the visual clearance of glyphs.",
    "Do not reuse the same primary photograph across multiple narrative pages.",
    "Do not copy company facts, logos, customers, people or product images from the example deck.",
    "Do not write promotional claims such as disruptive, certain, huge blue ocean or must invest without evidence.",
    "Do not deliver a full-slide image in place of editable PowerPoint content.",
    "Do not treat application preview as the authoritative Office rendering."
  ],
  "design_prompt": {
    "short": "Investment Editorial Research：暖白纸面、矿物绿与铜红、楷体中文、TNR 数字，以行动标题和连续证据结构呈现高密度投委会研究。",
    "long": "Create a reading-first investment committee deck that feels like a carefully edited research report rather than a financing pitch. Use warm paper, near-black ink, mineral green and restrained copper. Set Chinese in KaiTi and Latin/numbers in Times New Roman. Build every slide around one action title and one continuous evidence path. Alternate annotated photography, process chains, feedback loops, case journeys, migration charts, waterfalls, funnels, transaction flows and roadmaps. Preserve dense explanations and required metrics without shrinking body text. Use tables only for genuine row-column comparison. Keep all important PowerPoint content editable and validate through Microsoft PowerPoint native PDF export.",
    "style_do": [
      "Use state-and-explain narrative from industry source to company mechanism and validation.",
      "Use one core conclusion and at most two major visual regions per slide.",
      "Embed numbers in trends, cases, time, ratios and operational explanations.",
      "Use documentary company or industry images with concise captions.",
      "Use multiple layout archetypes while preserving one visual system.",
      "Keep sources, dates, units and actual/forecast definitions near the evidence."
    ],
    "style_dont": [
      "Do not use generic blue technology templates.",
      "Do not build card walls or field-list tables.",
      "Do not use decorative hard lines or arrows that touch text.",
      "Do not reduce density by deleting evidence or increase density by shrinking fonts.",
      "Do not copy subjects or facts from the Dayan example.",
      "Do not use marketing slogans as conclusions."
    ]
  },
  "quality_constraints": {
    "content": {
      "one_core_conclusion_per_slide": true,
      "baseline_document_metric_retention": true,
      "evidence_grade_and_definition_required": true,
