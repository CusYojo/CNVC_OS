{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investment compliance note content",
  "type": "object",
  "required": ["title", "sections", "closing", "open_issues"],
  "properties": {
    "title": {"type": "string", "minLength": 6},
    "as_of": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["heading", "blocks"],
        "properties": {
          "heading": {"type": "string"},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": {"enum": ["subheading", "paragraph", "numbered", "conclusion"]},
                "label": {"type": "string"},
                "text": {"type": "string"},
                "source_ids": {"type": "array", "items": {"type": "string"}},
                "status": {"enum": ["verified", "management_stated", "calculated", "pending", "not_applicable"]},
                "notes": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "closing": {
      "type": "object",
      "required": ["company", "date"],
      "properties": {"company": {"type": "string"}, "date": {"type": "string"}}
    },
    "open_issues": {"type": "array", "items": {"type": "string"}}
  }
}
