{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content-safe editable PPT replacement manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "templatePptx",
    "templateSha256",
    "projectName",
    "defaultAction",
    "operations"
  ],
  "properties": {
    "schemaVersion": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5", "1.6"]},
    "sourceMode": {"enum": ["pdf-converted", "native-pptx"]},
    "conversionHandoff": {"type": "string", "minLength": 1},
    "templatePptx": {"type": "string"},
    "templateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectName": {"type": "string", "minLength": 1},
    "defaultAction": {"enum": ["KEEP", "FAIL_UNCLASSIFIED_CONTENT"]},
    "projectIdentity": {"$ref": "#/$defs/projectIdentity"},
    "templateFingerprint": {"$ref": "#/$defs/templateFingerprint"},
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "slideBriefs": {
      "type": "array",
      "items": {"$ref": "#/$defs/slideBrief"}
    },
    "objectPolicy": {"$ref": "#/$defs/objectPolicy"},
    "visualQaPolicy": {"$ref": "#/$defs/visualQaPolicy"},
    "backgroundPolicy": {"$ref": "#/$defs/backgroundPolicy"},
    "protectedObjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/protectedObject"}
    },
    "slotGroups": {
      "type": "array",
      "items": {"$ref": "#/$defs/slotGroup"}
    },
    "entityBindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/entityBinding"}
    },
    "slotAssignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/slotAssignment"}
    },
    "contentPolicy": {"$ref": "#/$defs/contentPolicy"},
    "residualPolicy": {"$ref": "#/$defs/residualPolicy"},
    "pageClosures": {
      "type": "array",
      "items": {"$ref": "#/$defs/pageClosure"}
    },
    "researchPolicy": {"$ref": "#/$defs/researchPolicy"},
    "contentDensityPolicy": {"$ref": "#/$defs/contentDensityPolicy"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "evidenceRegistry": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"enum": ["1.3", "1.4", "1.5", "1.6"]}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "sourceMode",
          "researchPolicy",
          "sources",
          "evidenceRegistry",
          "protectedObjects",
          "slotGroups",
          "entityBindings",
          "slotAssignments"
        ]
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"enum": ["1.4", "1.5", "1.6"]}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "contentPolicy",
          "residualPolicy",
          "pageClosures"
        ]
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]}},
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {"defaultAction": {"const": "KEEP"}}
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"enum": ["1.5", "1.6"]}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "projectIdentity",
          "templateFingerprint",
          "facts",
          "slideBriefs",
          "objectPolicy",
          "visualQaPolicy"
        ],
        "properties": {
          "defaultAction": {"const": "FAIL_UNCLASSIFIED_CONTENT"}
        }
      }
    },
    {
      "if": {
        "properties": {"schemaVersion": {"const": "1.6"}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": ["backgroundPolicy"],
        "properties": {
          "visualQaPolicy": {
            "required": [
              "checkTemplateBackgroundFidelity",
              "checkLogoBackgroundArtifacts"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "contentPolicy": {
      "type": "object",
      "required": [
        "optionalMissingAction",
        "requiredMissingAction",
        "unavailableWebsiteAction",
        "forbidOperationalPlaceholders"
      ],
      "properties": {
        "optionalMissingAction": {"const": "delete-slot-group"},
        "requiredMissingAction": {"const": "dedicated-gap-slide-only"},
        "unavailableWebsiteAction": {"const": "omit-slot"},
        "forbidOperationalPlaceholders": {"const": true}
      },
      "additionalProperties": false
    },
    "projectIdentity": {
      "type": "object",
      "required": [
        "legalName",
        "aliases",
        "region",
        "officialDomains",
        "sourceIds",
        "identityEvidenceIds",
        "confidence",
        "identityStatus"
      ],
      "properties": {
        "legalName": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "region": {"type": "string", "minLength": 1},
        "officialDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "identifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "identityEvidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "confidence": {"enum": ["high", "medium", "low"]},
        "identityStatus": {"const": "verified"}
      },
      "additionalProperties": false
    },
    "templateFingerprint": {
      "type": "object",
      "required": [
        "reviewed",
        "oldProjectTerms",
        "oldProjectNumericTokens",
        "oldProjectMediaSha256",
        "numericDecisions",
        "mediaDecisions"
      ],
      "properties": {
        "reviewed": {"const": true},
        "oldProjectTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "oldProjectNumericTokens": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "oldProjectMediaSha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "oldEntityNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "numericDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["token", "disposition", "reason"],
            "properties": {
              "token": {"type": "string", "minLength": 1},
              "disposition": {
                "enum": ["old_project", "template_neutral", "template_index"]
              },
              "reason": {"type": "string", "minLength": 1},
              "factKey": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "mediaDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sha256", "disposition", "classification", "reason"],
            "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "disposition": {"enum": ["old_project", "template_neutral"]},
              "classification": {
                "enum": [
                  "company_logo",
                  "person_photo",
                  "product_screenshot",
                  "customer_evidence",
                  "company_specific_visual",
                  "template_brand",
                  "shared_semantic_icon",
                  "template_background",
                  "fixed_visual",
                  "generic_decoration"
                ]
              },
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "factKey",
        "semanticKey",
        "renderedValue",
        "factType",
        "materiality",
        "status",
        "evidenceIds"
      ],
      "properties": {
        "factKey": {"type": "string", "minLength": 1},
        "semanticKey": {"type": "string", "minLength": 1},
        "renderedValue": {"type": ["string", "number", "boolean"]},
        "rawValue": {"type": ["string", "number", "boolean"]},
        "factType": {"enum": ["text", "number", "date", "currency", "percentage", "entity", "asset"]},
        "unit": {"type": "string"},
        "currency": {"type": "string"},
        "period": {"type": "string"},
        "scope": {"type": "string"},
        "asOfDate": {"type": "string", "format": "date"},
        "materiality": {"enum": ["basic", "material"]},
        "status": {"enum": ["verified", "conflicting", "unavailable"]},
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "shapeBudget": {
      "type": "object",
      "required": ["shapeId", "maxChars", "maxLines"],
      "properties": {
        "shapeId": {"type": "integer", "minimum": 1},
        "maxChars": {"type": "integer", "minimum": 0},
        "maxLines": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "slideBrief": {
      "type": "object",
      "required": [
        "slide",
        "objective",
        "conclusion",
        "allowedSemanticKeys",
        "allowedFactKeys",
        "shapeBudgets"
      ],
      "properties": {
        "slide": {"type": "integer", "minimum": 1},
        "slideType": {
          "enum": ["cover", "section", "substantive", "closing"]
        },
        "objective": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string", "minLength": 1},
        "researchQueries": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 4}
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "contentItemSemanticKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "densityStatus": {
          "enum": ["ready", "thin", "exempt"]
        },
        "externalContextRequired": {"type": "boolean"},
        "pageResearchSummary": {"type": "string", "minLength": 1},
        "allowedSemanticKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowedFactKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "shapeBudgets": {
          "type": "array",
          "items": {"$ref": "#/$defs/shapeBudget"}
        }
      },
      "additionalProperties": false
    },
    "contentDensityPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "substantiveSlideNumbers",
        "excludedSlideNumbers",
        "externalContextSlideNumbers",
        "minimumContentItemsPerSubstantiveSlide",
        "minimumEvidenceItemsPerSubstantiveSlide",
        "minimumResearchQueriesPerSubstantiveSlide",
        "minimumWebSourcesPerExternalContextSlide",
        "maxTextCapacityUtilization",
        "thinSlideAction",
        "requireClaimDiversity"
      ],
      "properties": {
        "enabled": {"const": true},
        "substantiveSlideNumbers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "excludedSlideNumbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "externalContextSlideNumbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "minimumContentItemsPerSubstantiveSlide": {
          "type": "integer",
          "minimum": 4,
          "maximum": 12
        },
        "minimumEvidenceItemsPerSubstantiveSlide": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "minimumResearchQueriesPerSubstantiveSlide": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "minimumWebSourcesPerExternalContextSlide": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxTextCapacityUtilization": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.9
        },
        "thinSlideAction": {"const": "research-or-restructure"},
        "requireClaimDiversity": {"const": true}
      },
      "additionalProperties": false
    },
    "objectPolicy": {
      "type": "object",
      "required": [
        "fixedVisualAction",
        "projectSpecificAction",
        "unknownObjectAction",
        "fullDeckClosureRequired"
      ],
      "properties": {
        "fixedVisualAction": {"const": "keep"},
        "projectSpecificAction": {"const": "replace-or-delete"},
        "unknownObjectAction": {"const": "fail"},
        "fullDeckClosureRequired": {"const": true}
      },
      "additionalProperties": false
    },
    "visualQaPolicy": {
      "type": "object",
      "required": [
        "renderAllSlides",
        "checkOverflow",
        "checkOverlap",
        "checkImageCrop",
        "checkEmptySlots",
        "checkRepeatedBoilerplate"
      ],
      "properties": {
        "renderAllSlides": {"const": true},
        "checkOverflow": {"const": true},
        "checkOverlap": {"const": true},
        "checkImageCrop": {"const": true},
        "checkEmptySlots": {"const": true},
        "checkRepeatedBoilerplate": {"const": true},
        "checkTemplateBackgroundFidelity": {"const": true},
        "checkLogoBackgroundArtifacts": {"const": true}
      },
      "additionalProperties": false
    },
    "backgroundPolicy": {
      "type": "object",
      "required": [
        "preserveTemplateBackground",
        "allowBackgroundDeletion",
        "candidateDecisions"
      ],
      "properties": {
        "preserveTemplateBackground": {"const": true},
        "allowBackgroundDeletion": {"const": false},
        "candidateDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slide",
              "shapeId",
              "classification",
              "disposition",
              "reason"
            ],
            "properties": {
              "slide": {"type": "integer", "minimum": 1},
              "shapeId": {"type": "integer", "minimum": 1},
              "classification": {
                "enum": [
                  "template_background",
                  "project_content_visual",
                  "logo_backplate",
                  "not_background"
                ]
              },
              "disposition": {"enum": ["preserve", "replace", "delete"]},
              "reason": {"type": "string", "minLength": 8},
              "explicitVisualReview": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "residualPolicy": {
      "type": "object",
      "required": [
        "forbiddenTextTerms",
        "forbiddenMediaSha256",
        "requiredTextTerms",
        "gapOnlyTextTerms",
        "gapSlideNumbers",
        "ocrRequired"
      ],
      "properties": {
        "forbiddenTextTerms": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbiddenMediaSha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "requiredTextTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "gapOnlyTextTerms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "gapSlideNumbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "ocrRequired": {"const": true}
        ,
        "forbiddenNumericTokens": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "scanEmbeddedData": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "pageClosure": {
      "type": "object",
      "required": [
        "slide",
        "reviewedShapeIds",
        "allowedKeepShapeIds",
        "targetShapeIds",
        "unknownShapeIds"
      ],
      "properties": {
        "slide": {"type": "integer", "minimum": 1},
        "reviewedShapeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "allowedKeepShapeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "targetShapeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "unknownShapeIds": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "integer", "minimum": 1}
        },
        "keepDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shapeId", "classification", "reason"],
            "properties": {
              "shapeId": {"type": "integer", "minimum": 1},
              "classification": {
                "enum": [
                  "fixed_visual",
                  "template_background",
                  "shared_semantic_icon",
                  "template_brand",
                  "template_label",
                  "generic_decoration",
                  "evidence_backed_context"
                ]
              },
              "reason": {"type": "string", "minLength": 1},
              "entityRole": {"type": "string", "minLength": 1},
              "evidenceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "researchPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "asOfDate",
        "minimumIndependentSources",
        "unresolvedPolicy"
      ],
      "properties": {
        "enabled": {"const": true},
        "asOfDate": {"type": "string", "format": "date"},
        "minimumIndependentSources": {"type": "integer", "minimum": 2},
        "unresolvedPolicy": {
          "enum": [
            "mark-not-disclosed-or-delete-optional",
            "mark-pending-verification-or-delete-optional"
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "sourceId",
        "sourceType",
        "title",
        "publisher",
        "accessedDate"
      ],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "sourceType": {
          "enum": [
            "user_material",
            "company_official",
            "regulatory_filing",
            "government",
            "academic",
            "industry_report",
            "reputable_media",
            "other"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "publishedDate": {"type": "string", "format": "date"},
        "accessedDate": {"type": "string", "format": "date"},
        "locator": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidenceId",
        "claim",
        "valueType",
        "materiality",
        "status",
        "semanticKeys",
        "sourceIds",
        "confidence",
        "asOfDate"
      ],
      "properties": {
        "evidenceId": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "valueType": {
          "enum": [
            "user-provided",
            "official-fact",
            "corroborated-fact",
            "derived",
            "estimate",
            "unavailable"
          ]
        },
        "materiality": {"enum": ["basic", "material"]},
        "status": {
          "enum": [
            "verified",
            "single-source",
            "conflicting",
            "not-found"
          ]
        },
        "semanticKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "formula": {"type": "string"},
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "confidence": {"enum": ["high", "medium", "low"]},
        "asOfDate": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "protectedObject": {
      "type": "object",
      "required": ["slide", "shapeId", "classification", "reason"],
      "properties": {
        "slide": {"type": "integer", "minimum": 1},
        "shapeId": {"type": "integer", "minimum": 1},
        "classification": {
          "enum": [
            "shared_semantic_icon",
            "fixed_visual",
            "template_background",
            "template_brand",
            "template_label",
            "generic_decoration"
          ]
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "slotGroup": {
      "type": "object",
      "required": [
        "slotGroupId",
        "slide",
        "groupType",
        "optional",
        "shapeIds",
        "contentShapeIds",
        "decorationShapeIds",
        "layoutPolicy"
      ],
      "properties": {
        "slotGroupId": {"type": "string", "minLength": 1},
        "slide": {"type": "integer", "minimum": 1},
        "groupType": {
          "enum": [
            "optional_content",
            "award_slot",
            "person_card",
            "product_card",
            "case_card",
            "company_attribute"
          ]
        },
        "optional": {"type": "boolean"},
        "shapeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "contentShapeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "decorationShapeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "layoutPolicy": {"const": "preserve-grid"}
      },
      "additionalProperties": false
    },
    "labelBinding": {
      "type": "object",
      "required": ["shapeId", "labelType", "expectedText"],
      "properties": {
        "shapeId": {"type": "integer", "minimum": 1},
        "labelType": {
          "enum": [
            "name",
            "title",
            "product_name",
            "product_model",
            "caption",
            "company_name"
          ]
        },
        "expectedText": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "entityBinding": {
      "type": "object",
      "required": [
        "bindingId",
        "entityId",
        "entityType",
        "displayName",
        "asset",
        "sourceNote",
        "slide",
        "imageShapeId",
        "labelBindings"
      ],
      "properties": {
        "bindingId": {"type": "string", "minLength": 1},
        "entityId": {"type": "string", "minLength": 1},
        "entityType": {
          "enum": ["person", "product", "customer", "case", "company", "institution"]
        },
        "entityRole": {
          "enum": [
            "target_company",
            "investment_institution",
            "competitor",
            "customer",
            "case_subject"
          ]
        },
        "displayName": {"type": "string", "minLength": 1},
        "asset": {"type": "string", "minLength": 1},
        "sourceNote": {"type": "string", "minLength": 1},
        "slide": {"type": "integer", "minimum": 1},
        "slotGroupId": {"type": "string", "minLength": 1},
        "imageShapeId": {"type": "integer", "minimum": 1},
        "labelBindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/labelBinding"}
        }
      },
      "additionalProperties": false
    },
    "slotAssignment": {
      "type": "object",
      "required": [
        "assignmentId",
        "slide",
        "semanticKey",
        "semanticRole",
        "requirement",
        "disposition",
        "shapeIds",
        "expectedContentShapeIds",
        "sourceNote"
      ],
      "properties": {
        "assignmentId": {"type": "string", "minLength": 1},
        "slide": {"type": "integer", "minimum": 1},
        "slotGroupId": {"type": "string", "minLength": 1},
        "semanticKey": {"type": "string", "minLength": 1},
        "semanticRole": {"type": "string", "minLength": 1},
        "requirement": {
          "enum": ["required", "optional", "shared", "template"]
        },
        "disposition": {"enum": ["replace", "delete", "keep"]},
        "shapeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "expectedContentShapeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "sourceNote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["slide", "role", "action", "reason", "sourceNote"],
      "properties": {
        "slide": {"type": "integer", "minimum": 1},
        "shapeId": {"type": "integer", "minimum": 1},
        "shapeIds": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "integer", "minimum": 1}
        },
        "primaryShapeId": {"type": "integer", "minimum": 1},
        "slotGroupId": {"type": "string", "minLength": 1},
        "bindingId": {"type": "string", "minLength": 1},
        "semanticKey": {"type": "string", "minLength": 1},
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "factKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "displayQualifier": {"type": "string"},
        "role": {"type": "string", "minLength": 1},
        "action": {
          "enum": [
            "replace_text",
            "replace_text_group",
            "add_disclaimer_textbox",
            "replace_image",
            "replace_chart_data",
            "replace_table_data",
            "delete_slot_group"
          ]
        },
        "text": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0}
        },
        "fontSize": {"type": "number", "minimum": 8, "maximum": 18},
        "fontFace": {"type": "string", "minLength": 1},
        "fontColor": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "allowEmpty": {"type": "boolean"},
        "allowLineCountChange": {"type": "boolean"},
        "groupMode": {"enum": ["fragment-map", "line-reflow", "composite-box"]},
        "fragmentTexts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["shapeId", "text"],
            "properties": {
              "shapeId": {"type": "integer", "minimum": 1},
              "text": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "capacityCheck": {
          "type": "object",
          "required": ["maxChars", "maxLines"],
          "properties": {
            "maxChars": {"type": "integer", "minimum": 0},
            "maxLines": {"type": "integer", "minimum": 1},
            "reviewed": {"const": true}
          },
          "additionalProperties": false
        },
        "styleLock": {"enum": ["exact", "controlled-disclaimer"]},
        "asset": {"type": "string"},
        "assetSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assetClass": {
          "enum": [
            "company_logo",
            "person_photo",
            "product_screenshot",
            "customer_evidence",
            "company_specific_visual",
            "user_approved_visual"
          ]
        },
        "companySpecific": {"type": "boolean"},
        "explicitUserApproval": {"type": "boolean"},
        "allowIconSlotReplacement": {"type": "boolean"},
        "imageFitMode": {"enum": ["contain", "cover", "preserve-crop"]},
        "aspectRatioValidated": {"type": "boolean"},
        "fitPreparedAsset": {"type": "boolean"},
        "logoTransparencyValidated": {"type": "boolean"},
        "logoSlotPolicy": {
          "type": "object",
          "required": ["backgroundMode", "companionObjects"],
          "properties": {
            "backgroundMode": {
              "enum": ["transparent", "preserve_template_backplate"]
            },
            "companionObjects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["shapeId", "role", "disposition", "reason"],
                "properties": {
                  "shapeId": {"type": "integer", "minimum": 1},
                  "role": {
                    "enum": [
                      "old_company_backplate",
                      "template_backplate",
                      "mask_or_frame",
                      "not_backplate"
                    ]
                  },
                  "disposition": {"enum": ["delete", "preserve"]},
                  "reason": {"type": "string", "minLength": 8}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "missingContent": {"type": "boolean"},
        "categories": {"type": "array"},
        "series": {"type": "array"},
        "values": {"type": "array"},
        "dataBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "factKey"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "factKey": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "reason": {"type": "string", "minLength": 1},
        "sourceNote": {"type": "string", "minLength": 1},
        "fitPolicy": {"const": "preserve"}
      },
      "additionalProperties": false
    }
  }
}
