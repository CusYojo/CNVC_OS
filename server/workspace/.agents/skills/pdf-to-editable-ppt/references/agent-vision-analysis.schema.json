{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-vision-analysis.schema.json",
  "title": "PDF page vision analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageType", "confidence", "regions"],
  "properties": {
    "pageType": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "typography": {"$ref": "#/$defs/typography"},
    "regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/region"}
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {"type": "string"},
        "fill": {"type": "string"},
        "color": {"type": "string"},
        "width": {"type": "number", "minimum": 0},
        "transparency": {"type": "number", "minimum": 0, "maximum": 100},
        "dash": {"type": "string"}
      }
    },
    "arrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "width": {"type": "string"},
        "length": {"type": "string"}
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": {"type": "number", "minimum": 1, "maximum": 400},
        "typeface": {"type": "string"},
        "color": {"type": "string"},
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "alignment": {"type": "string"},
        "verticalAlignment": {"type": "string"},
        "autoFit": {"type": "string"},
        "wrap": {"type": "string"},
        "rotation": {"type": "number", "minimum": -360, "maximum": 360},
        "insets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {"type": "number", "minimum": 0},
            "right": {"type": "number", "minimum": 0},
            "bottom": {"type": "number", "minimum": 0},
            "left": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "baseObject": {
      "type": "object",
      "required": ["id", "type", "bbox"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "shape": {
      "allOf": [
        {"$ref": "#/$defs/baseObject"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "bbox"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "name": {"type": "string"},
            "type": {"const": "shape"},
            "bbox": {"$ref": "#/$defs/bbox"},
            "geometry": {"type": "string"},
            "fill": {"type": "string"},
            "line": {"$ref": "#/$defs/line"},
            "text": {"type": "string"},
            "textEvidenceId": {"type": "string"},
            "textStyle": {"$ref": "#/$defs/textStyle"}
          }
        }
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bbox"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "type": {"const": "text"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text": {"type": "string"},
        "textEvidenceId": {"type": "string"},
        "textStyle": {"$ref": "#/$defs/textStyle"}
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bbox", "from", "to"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "type": {"const": "connector"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "kind": {"type": "string"},
        "fromSide": {"type": "string"},
        "toSide": {"type": "string"},
        "line": {"$ref": "#/$defs/line"},
        "head": {"$ref": "#/$defs/arrow"},
        "tail": {"$ref": "#/$defs/arrow"},
        "cap": {"type": "string"},
        "join": {"type": "string"}
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bbox"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "type": {"const": "icon"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "mode": {"type": "string"},
        "geometry": {"type": "string"},
        "fill": {"type": "string"},
        "line": {"$ref": "#/$defs/line"},
        "asset": {"type": "string"},
        "svg": {"type": "string"},
        "parts": {"type": "array"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bbox"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "type": {"const": "table"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "verifiedData": {"type": "boolean"},
        "values": {"type": "array", "items": {"type": "array"}},
        "fontSize": {"type": "number"},
        "fontFace": {"type": "string"},
        "color": {"type": "string"},
        "fill": {"type": "string"},
        "border": {"type": "object"},
        "margin": {"type": "number"}
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bbox"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "type": {"const": "chart"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "verifiedData": {"type": "boolean"},
        "chartType": {"type": "string"},
        "categories": {"type": "array"},
        "series": {"type": "array"},
        "hasLegend": {"type": "boolean"},
        "showValue": {"type": "boolean"},
        "holeSize": {"type": "number"}
      }
    },
    "visionObject": {
      "oneOf": [
        {"$ref": "#/$defs/shape"},
        {"$ref": "#/$defs/text"},
        {"$ref": "#/$defs/connector"},
        {"$ref": "#/$defs/icon"},
        {"$ref": "#/$defs/table"},
        {"$ref": "#/$defs/chart"}
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "bbox",
        "recommendedAction",
        "confidence",
        "reconstructionComplete",
        "objects"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "flowchart", "table", "chart", "matrix", "icon-group", "photo",
            "screenshot", "illustration", "decoration", "watermark",
            "text-block", "unknown"
          ]
        },
        "bbox": {"$ref": "#/$defs/bbox"},
        "recommendedAction": {
          "enum": [
            "semantic-rebuild", "ocr-text", "keep-raster", "review", "ignore"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reconstructionComplete": {"type": "boolean"},
        "summary": {"type": "string"},
        "coverFill": {"type": "string"},
        "expectedObjectCount": {"type": "integer", "minimum": 0},
        "sourceImageElementIndex": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"},
        "objects": {
          "type": "array",
          "items": {"$ref": "#/$defs/visionObject"}
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceFontVerified": {"type": "boolean"},
        "bodyFontCandidates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "titleFontCandidates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["styleId", "fontSizePt", "bold"],
            "properties": {
              "styleId": {"type": "string", "minLength": 1},
              "role": {"type": "string"},
              "fontFamily": {"type": "string"},
              "fontSizePt": {"type": "number", "minimum": 5, "maximum": 400},
              "bold": {"type": "boolean"},
              "italic": {"type": "boolean"},
              "color": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
