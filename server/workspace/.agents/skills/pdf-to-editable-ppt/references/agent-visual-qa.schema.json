{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "confidence", "issues", "summary"],
  "properties": {
    "passed": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "issues": {
      "type": "array",
      "items": {"type": "object"}
    },
    "summary": {"type": "string"}
  }
}
