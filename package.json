{
  "name": "intelligent-investment-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB,AGENT,RADAR -c green,blue,magenta,yellow \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:agent\" \"npm:dev:radar\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env --exclude \"server/ai-template-data/**\" --exclude \"server/ai-artifacts/**\" --exclude \"server/.venv/**\" --exclude \".runtime/**\" server/src/index.ts",
    "dev:agent": "npm --prefix cybernaut-assistant run dev:local",
    "dev:radar": "project-discovery/start.sh",
    "build": "npm run build:platform && npm run build:agent",
    "build:platform": "tsc -b && tsc -p server/tsconfig.build.json && vite build",
    "build:agent": "npm --prefix cybernaut-assistant run build",
    "check": "npm run check:platform && npm run check:agent",
    "check:platform": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "check:agent": "npm --prefix cybernaut-assistant run check",
    "check:agent-runtime": "node --env-file-if-exists=.env cybernaut-assistant/scripts/healthcheck.mjs",
    "setup:pdf-to-ppt": "node server/scripts/setup-pdf-to-ppt-runtime.mjs",
    "accept:ai-business": "node --import tsx server/src/scripts/aiBusinessAcceptance.ts",
    "accept:ai-api": "node --import tsx server/src/scripts/aiTaskApiAcceptance.ts",
    "accept:ai-compliance": "node --import tsx server/src/scripts/aiComplianceAcceptance.ts",
    "accept:ai-compliance-api": "AI_ACCEPTANCE_SCOPE=compliance node --import tsx server/src/scripts/aiTaskApiAcceptance.ts",
    "dev:ai-acceptance-llm": "node --import tsx server/src/scripts/aiAcceptanceLlmGateway.ts",
    "accept:ai-proposal": "node --import tsx server/src/scripts/aiInvestmentProposalAcceptance.ts",
    "accept:ai-qa": "node --import tsx server/src/scripts/aiQaPipelineAcceptance.ts",
    "accept:ai-qa-api": "AI_ACCEPTANCE_SCOPE=qa node --import tsx server/src/scripts/aiTaskApiAcceptance.ts",
    "accept:ai-skills": "node --import tsx server/src/scripts/aiSkillAcceptance.ts",
    "accept:ai-custom-template": "node --import tsx server/src/scripts/aiCustomTemplateAcceptance.ts",
    "start": "node --env-file-if-exists=.env server-dist/index.js",
    "start:agent": "npm --prefix cybernaut-assistant run start:local",
    "start:radar": "project-discovery/start.sh",
    "start:all": "concurrently -k -n API,AGENT,RADAR -c green,magenta,yellow \"npm:start\" \"npm:start:agent\" \"npm:start:radar\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@flue/react": "^1.0.0-beta.9",
    "@flue/sdk": "^1.0.0-beta.9",
    "@napi-rs/canvas": "^0.1.80",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "docx": "^9.5.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
